#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

started_at=$SECONDS
echo "[setup] Ensuring pinned tools"

if command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
else
  curl -fsSL https://mise.run | MISE_VERSION=v2026.8.10 sh
  mise_bin="${HOME}/.local/bin/mise"
fi

"$mise_bin" install
"$mise_bin" exec -- bun install --frozen-lockfile

[[ -f .env ]] || cp -- .env.example .env
mkdir -p data

echo "[setup] Complete in $((SECONDS - started_at))s"
